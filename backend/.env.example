# URL de conexão Postgres (Supabase)
# Exemplo: postgresql://postgres:senha@db.xxxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Opcional: liberar origem exata do frontend publicado
# CORS_ORIGIN=https://seu-front.vercel.app
CORS_ORIGIN=

# Opcional: pasta das imagens do cardápio para o pedir online
# CARDAPIO_IMG_DIR=C:\Users\celei\Downloads\fotocardapio
CARDAPIO_IMG_DIR=

# Opcional: porta local
PORT=3001

# PIX automático (Mercado Pago): Access Token da aplicação em
# https://www.mercadopago.com.br/developers -> Suas integrações -> Credenciais
# Use o token de TESTE (TEST-...) para validar antes de trocar para produção (APP_USR-...)
MP_ACCESS_TOKEN=
